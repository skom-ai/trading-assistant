# =====================================================================
# File: .env.example
# Description: Environment template for the Valtide docker-compose stack.
#              Copy to `.env` and adjust. Local defaults are dev-safe; do
#              NOT reuse these credentials outside local Docker.
# =====================================================================

# ---- PostgreSQL ----
POSTGRES_USER=valtide
POSTGRES_PASSWORD=valtide
POSTGRES_DB=valtide

# ---- MongoDB (audit-only trace store) ----
MONGO_USER=root
MONGO_PASSWORD=root

# ---- Agent (FastAPI) ----
GEMINI_API_KEY=<GET API KEY>
# LLM provider: 'mock' (deterministic, offline default) or 'gemini'.
VT_LLM_PROVIDER=gemini
VT_LLM_API_KEY=<GET API KEY>

# ---- Agent orchestration framework (LangChain migration) ----
# 'native'    = original hand-rolled FR1/FR3 orchestration (default; zero
#               behavior change). 'langchain' = LangGraph state machines.
VT_LLM_FRAMEWORK=native
# ---- LangSmith observability (agents) ----
# Off by default. Set VT_LANGSMITH_TRACING=true and a key to trace graphs.
VT_LANGSMITH_TRACING=false
VT_LANGSMITH_API_KEY=<GET LANGSMITH KEY>
VT_LANGSMITH_PROJECT=valtide-agents
VT_LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Service-to-service auth (BFF -> Agent) ----
INTERNAL_API_TOKEN=dev-internal-token

# ---- BFF (NestJS) ----
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT=60

# ---- UI (Vite) ----
VITE_BFF_BASE_URL=http://localhost:8080

# ---- Observability: API + UI (OpenTelemetry -> Grafana LGTM) ----
# Empty = tracing OFF (default). Set to http://lgtm:4318 (inside compose) to
# emit OTLP traces to the bundled Grafana LGTM stack (Grafana UI on :3001).
# In GCP/AWS point this at your OTel Collector instead; app code is unchanged.
OTEL_EXPORTER_OTLP_ENDPOINT=
# UI is a browser app: it needs its own (browser-reachable) collector URL.
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=


LANGSMITH_API_KEY=<Add yur key>
LANGSMITH_WORKSPACE=<Add your workspace
LANGSMITH_APPLICATION=<Add your application name>
